<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %></title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
</head>
<body>
<a class="skip-link" href="#primary">Skip to content</a>

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-logo" href="/">
      <span class="mark">365</span>
      365 Technologies
    </a>

    <button class="nav-toggle" aria-expanded="false" aria-controls="primary-nav" aria-label="Toggle menu">
      <span></span><span></span><span></span>
    </button>

    <nav id="primary-nav" class="primary-nav" aria-label="Primary">
      <ul>
        <li class="<%= active === 'home' ? 'is-active' : '' %>"><a href="/">Home</a></li>
        <li class="has-children <%= active === 'catalog' ? 'is-active' : '' %>">
          <a href="/catalog">Catalog</a>
          <ul class="sub-menu">
            <% catalog.forEach(function (c) { %>
              <li><a href="/catalog/<%= c.slug %>"><%= c.name %></a></li>
            <% }) %>
          </ul>
        </li>
        <li class="<%= active === 'who-we-are' ? 'is-active' : '' %>"><a href="/who-we-are">Who We Are</a></li>
        <li class="<%= active === 'contact-us' ? 'is-active' : '' %>"><a href="/contact-us">Contact</a></li>
      </ul>
    </nav>

    <div class="header-cta">
      <span class="phone"><%= site.phone %></span>
      <a class="btn" href="/contact-us">Get in Touch</a>
    </div>
  </div>
</header>

<main id="primary">

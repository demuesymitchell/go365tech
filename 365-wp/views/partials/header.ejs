<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %></title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="icon" type="image/png" href="/img/logo/365-logo-color.png">
<link rel="stylesheet" href="/css/style.css">
</head>
<body>
<a class="skip-link" href="#primary">Skip to content</a>

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-logo" href="/">
      <img class="site-logo__img" src="/img/logo/365-logo-color.png" alt="365 Technologies">
      365 Technologies
    </a>

    <nav id="primary-nav" class="primary-nav" aria-label="Primary">
      <ul>
        <li class="<%= active === 'home' ? 'is-active' : '' %>"><a href="/">Home</a></li>
        <li class="has-children <%= active === 'catalog' ? 'is-active' : '' %>">
          <a href="/catalog">Catalog</a>
          <ul class="sub-menu">
            <% catalog.forEach(function (c) { %>
              <li><a href="/catalog/<%= c.slug %>"><%= c.name %></a></li>
            <% }) %>
          </ul>
        </li>
        <li class="<%= active === 'who-we-are' ? 'is-active' : '' %>"><a href="/who-we-are">Who We Are</a></li>
        <li class="<%= active === 'contact-us' ? 'is-active' : '' %>"><a href="/contact-us">Contact</a></li>
      </ul>
    </nav>

    <div class="header-search">
      <form action="/search" method="GET">
        <input type="text" name="q" placeholder="Search the catalog…" value="<%= typeof query !== 'undefined' ? query : '' %>" aria-label="Search the catalog">
        <button type="submit" aria-label="Search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        </button>
      </form>
    </div>

    <div class="header-cta">
      <a class="btn" href="/contact-us">Get in Touch</a>
    </div>

    <button class="nav-toggle" aria-expanded="false" aria-controls="primary-nav" aria-label="Toggle menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<main id="primary">

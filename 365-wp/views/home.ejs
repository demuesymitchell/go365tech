<%- include('partials/header') %>

<section class="hero">
  <div class="container">
    <span class="eyebrow">Design Catalog</span>
    <h1>Find the gas spring, hydraulic, or pneumatic solution your application needs.</h1>
    <p class="lead">365 Technologies designs for automotive, agricultural, medical, and industrial equipment manufacturers. Search the catalog or browse by discipline below — no pricing, just the engineering.</p>

    <div class="hero-search">
      <form action="/search" method="GET">
        <input type="text" name="q" placeholder="Search products — e.g. &quot;gas spring&quot;, &quot;valve&quot;, &quot;pump&quot;" aria-label="Search the catalog">
        <button type="submit">Search</button>
      </form>
      <div class="hero-search__hints">
        Popular:
        <% catalog.forEach(function (c, i) { %><a href="/catalog/<%= c.slug %>"><%= c.name %></a><%= i < catalog.length - 1 ? ' · ' : '' %><% }) %>
      </div>
    </div>
  </div>
</section>

<section class="catalog-section">
  <div class="container">
    <div class="catalog-section__head">
      <div>
        <span class="eyebrow">Browse by Discipline</span>
        <h2>What we design</h2>
      </div>
      <a class="btn-ghost" href="/catalog">View full catalog →</a>
    </div>

    <div class="category-grid">
      <% catalog.forEach(function (c) { %>
        <a class="category-card" href="/catalog/<%= c.slug %>">
          <div class="category-card__media"><span>Image Placeholder</span></div>
          <div class="category-card__body">
            <h3><%= c.name %></h3>
            <p><%= c.tagline %></p>
            <span class="category-card__count"><%= c.items.length %> in catalog →</span>
          </div>
        </a>
      <% }) %>
      <div class="placeholder-card">
        <div class="placeholder-card__icon">+</div>
        <h3>More Disciplines</h3>
        <p>Coming soon as the catalog grows</p>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>

<%- include('partials/header') %>

<section class="hero">
  <div class="container">
    <span class="eyebrow">Design Catalog</span>
    <h1>Gas spring, hydraulic &amp; pneumatic engineering — browsable, visual, built for how you spec.</h1>
    <p class="lead">365 Technologies partners with automotive, agricultural, medical, and industrial equipment manufacturers to design the systems their products depend on. Browse what we build below.</p>
    <div class="btn-row">
      <a class="btn" href="/catalog">Browse the Catalog</a>
      <a class="btn btn-outline" href="/contact-us">Get in Touch</a>
    </div>
  </div>
</section>

<section class="catalog-section">
  <div class="container">
    <div class="catalog-section__head">
      <div>
        <span class="eyebrow">What We Build</span>
        <h2>Three disciplines, one team</h2>
      </div>
      <a class="btn-ghost" href="/catalog">View full catalog →</a>
    </div>

    <div class="category-grid">
      <% catalog.forEach(function (c) { %>
        <a class="category-card" href="/catalog/<%= c.slug %>">
          <div class="category-card__media">
            <span class="category-card__tag"><%= c.name %></span>
          </div>
          <div class="category-card__body">
            <h3><%= c.name %></h3>
            <p><%= c.tagline %></p>
            <span class="category-card__count"><%= c.items.length %> in catalog →</span>
          </div>
        </a>
      <% }) %>
    </div>
  </div>
</section>

<section class="map-section">
  <iframe src="<%= site.mapEmbed %>" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="365 Technologies location"></iframe>
</section>

<div class="cta-band">
  <div class="container">
    <span class="eyebrow">Let's Talk</span>
    <h2>Have an application in mind?</h2>
    <p>Tell us what you're building — we'll help scope the gas spring, hydraulic, or pneumatic system it needs.</p>
    <a class="btn" href="/contact-us">Contact Us</a>
  </div>
</div>

<%- include('partials/footer') %>

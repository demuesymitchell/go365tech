<%- include('partials/header') %>

<section class="hero">
  <div class="container">
    <span class="eyebrow">Gas Spring · Hydraulic · Pneumatic Design</span>
    <h1>Engineered solutions built around your application, not the other way around</h1>
    <p class="lead">365 Technologies partners with automotive, agricultural, medical, and industrial equipment manufacturers to design, build, and service the systems their products depend on.</p>
    <div class="btn-row">
      <a class="btn" href="/what-we-do">What We Do</a>
      <a class="btn btn-outline" href="/contact-us">Request a Quote</a>
    </div>
  </div>
  <div class="hero__bottom-space"></div>
</section>

<div class="stat-band">
  <div class="container stat-band__grid">
    <div class="stat-band__item">
      <div class="stat-band__number">50+</div>
      <div class="stat-band__label">Years Combined<br>Industry Experience</div>
    </div>
    <div class="stat-band__item">
      <div class="stat-band__number">3</div>
      <div class="stat-band__label">Core Disciplines —<br>Gas Spring, Hydraulic, Pneumatic</div>
    </div>
    <div class="stat-band__item">
      <div class="stat-band__number">4</div>
      <div class="stat-band__label">Focus Markets Served<br>Nationwide</div>
    </div>
    <div class="stat-band__item">
      <div class="stat-band__number">1</div>
      <div class="stat-band__label">Team-Based Design<br>Approach, Start to Finish</div>
    </div>
  </div>
</div>

<section class="trust-section">
  <div class="container">
    <div class="trust-section__head">
      <span class="eyebrow">Why 365 Technologies</span>
      <h2>Design is built into our DNA</h2>
    </div>
    <div class="trust-grid">
      <div class="trust-card">
        <span class="trust-card__num">01</span>
        <h3>Design-First Engineering</h3>
        <p>We're a design integrator, providing application design assistance through a team-based approach featuring over fifty years of industry experience.</p>
      </div>
      <div class="trust-card">
        <span class="trust-card__num">02</span>
        <h3>On-Site Troubleshooting &amp; Service</h3>
        <p>Beyond design, we offer on-site troubleshooting and service for hydraulic and pneumatic systems already in the field — including those already deemed in need of repair.</p>
      </div>
      <div class="trust-card">
        <span class="trust-card__num">03</span>
        <h3>Broad Market Experience</h3>
        <p>From specialty and commercial automotive to agricultural, medical, and industrial equipment — we bring the right engineering fit to every market we serve.</p>
      </div>
    </div>
  </div>
</section>

<section class="feature-row" style="border-bottom:none;">
  <div class="container feature-row__grid">
    <div class="feature-row__media" aria-hidden="true">Product / facility photo</div>
    <div class="feature-row__body">
      <span class="eyebrow">Hydraulic &amp; Pneumatic</span>
      <h2>Learn more about our diverse offerings</h2>
      <p>Whether your product or service requires hydraulic or pneumatic products, our technical design team can provide you the best fit.</p>
      <a class="btn" href="/what-we-do">See what we do →</a>
    </div>
  </div>
</section>

<section class="applications-section" style="background:var(--color-bg-alt);">
  <div class="container">
    <div class="applications-section__head">
      <span class="eyebrow">Where We Work</span>
      <h2>Markets we serve</h2>
    </div>
    <div class="applications-grid">
      <div class="app-tile">
        <div class="app-tile__icon">A</div>
        <h3>Automotive</h3>
        <p>Specialty &amp; commercial vehicles</p>
      </div>
      <div class="app-tile">
        <div class="app-tile__icon">Ag</div>
        <h3>Agricultural</h3>
        <p>Equipment manufacturers</p>
      </div>
      <div class="app-tile">
        <div class="app-tile__icon">M</div>
        <h3>Medical</h3>
        <p>Patient handling &amp; specialty equipment</p>
      </div>
      <div class="app-tile">
        <div class="app-tile__icon">I</div>
        <h3>Industrial</h3>
        <p>Aerial &amp; lift equipment</p>
      </div>
    </div>
  </div>
</section>

<section class="map-section">
  <iframe src="<%= site.mapEmbed %>" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="365 Technologies location"></iframe>
</section>

<div class="cta-band">
  <div class="container">
    <h2>Let's engineer your solution</h2>
    <p>Tell us what you're building — we'll help scope the gas spring, hydraulic, or pneumatic system it needs.</p>
    <a class="btn" href="/contact-us">Contact Us</a>
  </div>
</div>

<%- include('partials/footer') %>

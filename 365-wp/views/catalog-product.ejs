<%- include('partials/header') %>

<div class="container">
  <div class="catalog-shell">
    <div class="catalog-shell__crumb">
      <a href="/">Home</a> » <a href="/catalog">Catalog</a> » <a href="/catalog/<%= cat.slug %>"><%= cat.name %></a> » <span class="current"><%= item.name %></span>
    </div>
    <div class="catalog-layout">
      <% var activeCatSlug = cat.slug; var activeItemSlug = item.slug; %>
      <%- include('partials/catalog-sidebar') %>

      <div class="catalog-content">
        <div class="product-detail-grid">
          <div class="product-media"><span>Image Placeholder</span></div>
          <div>
            <span class="eyebrow"><%= cat.name %></span>
            <h1 class="product-detail-title"><%= item.name %></h1>
            <p style="font-size:1rem;"><%= item.blurb %></p>

            <table class="spec-table">
              <% item.specs.forEach(function (row) { %>
                <tr><td><%= row[0] %></td><td><%= row[1] %></td></tr>
              <% }) %>
            </table>

            <a class="btn" href="/contact-us">Discuss This Application</a>
          </div>
        </div>

        <% if (related.length) { %>
          <div style="margin-top:48px;padding-top:36px;border-top:1px solid var(--line);">
            <h2 style="font-size:1.25rem;margin-bottom:18px;">More in <%= cat.name %></h2>
            <div class="item-grid">
              <% related.forEach(function (r) { %>
                <a class="item-card" href="/catalog/<%= cat.slug %>/<%= r.slug %>">
                  <div class="item-card__media"><span>Image Placeholder</span></div>
                  <div class="item-card__body">
                    <h3><%= r.name %></h3>
                    <p><%= r.blurb %></p>
                  </div>
                </a>
              <% }) %>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
